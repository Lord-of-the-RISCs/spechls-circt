/*
 * Refined bisimulation model for the speculative slow/fast loop described in
 * slowfast.mlir. The goal is to model the sequential trace (trace_x) and the
 * speculative pipeline machine (trace_y) together so that Uclid can prove their
 * outputs coincide despite stalls, rollbacks, and commit control.
 */
module slowfast_full {

  function slow(a: integer): integer;
  function fast(a: integer): integer;
  function cond(a: integer): boolean;
  function exit(a: integer): boolean;

  define step(x: integer): integer =
    if (cond(x)) then slow(x) else fast(x);

  procedure commit_y(i: integer, value: integer) modifies trace_y; {
    trace_y[i] = value;
  }

  procedure commit_x(i: integer, value: integer) modifies trace_x; {
    trace_x[i] = value;
  }

  type trace_t = [integer] integer;
  var trace_x: trace_t;
  var trace_y: trace_t;

  var i: integer;
  var i_x: integer;
  var commit: boolean;
  var cpt: bv3;

  type t_state = enum { STEP0, STALL, ROLLBACK, END };
  var cs: t_state;

  init {
    trace_x[0] = 0;
    trace_y[0] = 0;
    i = 0;
    i_x = 0;
    commit = false;
    cpt = 0bv3;
    cs = STEP0;
  }

  next {
    if (!exit(trace_x[i_x])) {
      i_x' = i_x + 1;
      call commit_x(i_x + 1, step(trace_x[i_x]));
    }

    case
      cs == STEP0: {
        if (!exit(trace_y[i])) {
          if (cond(trace_y[i])) {
            cpt' = 2bv3;
            commit' = false;
            cs' = STALL;
          } else {
            i' = i + 1;
            commit' = true;
            call commit_y(i + 1, fast(trace_y[i]));
          }
        } else {
          cs' = END;
          commit' = false;
        }
      }
      cs == STALL: {
        commit' = false;
        if (cpt == 0bv3) {
          cs' = ROLLBACK;
        } else {
          cpt' = cpt - 1bv3;
        }
      }
      cs == ROLLBACK: {
        i' = i + 1;
        commit' = true;
        call commit_y(i + 1, slow(trace_y[i]));
        cs' = STEP0;
      }
      cs == END: {
        commit' = false;
        cs' = END;
      }
      default: {
        commit' = false;
        cs' = END;
      }
    esac;
  }

  invariant nonneg_indices : i >= 0 && i_x >= 0;
  invariant fast_le_spec : i_x >= i;
  invariant trace_x_sequence : (i_x > 0) ==> trace_x[i_x] == step(trace_x[i_x - 1]);
  invariant trace_y_sequence : (i > 0) ==> trace_y[i] == step(trace_y[i - 1]);
  invariant committed_equality : (forall (k: integer) :: (0 <= k && k <= i) ==> trace_x[k] == trace_y[k]);
  invariant stall_condition : (cs == STALL) ==> cond(trace_y[i]);
  invariant rollback_condition : (cs == ROLLBACK) ==> cond(trace_y[i]);
  invariant fast_commit_guard : (commit && cs == STEP0) ==> !cond(trace_y[i]);
  invariant slow_commit_guard : (commit && cs == ROLLBACK) ==> cond(trace_y[i]);
  invariant rollback_counter : (cs == ROLLBACK) ==> cpt == 0bv3;
  invariant stall_counter_bound : (cs == STALL) ==> cpt <= 2bv3;
  invariant end_commits_false : (cs == END) ==> !commit;
  invariant exit_persists : cs == END ==> exit(trace_y[i]);

  control {
    vobj = induction(12);
    check;
    print_results;
  }
}
